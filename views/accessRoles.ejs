<%- include('partials/head', { title: 'Perfis de Acesso' }) %>
<%- include('partials/sidebar', { activePage: 'access-roles' }) %>
      <h1>Perfis de Acesso</h1>
      <table class="data-table">
        <thead>
          <tr><th>Nome</th><th>Escopo</th><th>Empresa</th><th>Permissões</th></tr>
        </thead>
        <tbody>
          <% if (roles.length === 0) { %>
            <tr><td colspan="4">Nenhum perfil cadastrado ainda.</td></tr>
          <% } %>
          <% roles.forEach(function(r) { %>
            <tr>
              <td><%= r.name %></td>
              <td><%= r.scope %></td>
              <td><%= r.company ? r.company.name : '—' %></td>
              <td><%= r.permissions.map(function(p) { return p.code; }).join(', ') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
<%- include('partials/footer') %>
