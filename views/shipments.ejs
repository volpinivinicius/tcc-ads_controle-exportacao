<%- include('partials/head', { title: 'Embarques' }) %>
<%- include('partials/sidebar', { activePage: 'shipments' }) %>
      <div class="page-header">
        <h1>Embarques</h1>
        <a href="/shipments/new" class="button-link">+ Novo Embarque</a>
      </div>
      <form method="GET" action="/shipments" class="filter-bar">
        <select name="modal">
          <option value="">Todos os modais</option>
          <% ['MARITIME', 'AIR', 'ROAD', 'OTHER'].forEach(function(m) { %>
            <option value="<%= m %>" <%= filters.modal === m ? 'selected' : '' %>><%= m %></option>
          <% }); %>
        </select>
        <select name="processType">
          <option value="">Exportação, importação ou intercompany</option>
          <% ['EXPORT', 'IMPORT', 'INTERCOMPANY'].forEach(function(p) { %>
            <option value="<%= p %>" <%= filters.processType === p ? 'selected' : '' %>><%= p %></option>
          <% }); %>
        </select>
        <select name="status">
          <option value="">Todos os status</option>
          <% Object.keys(statusLabels).forEach(function(code) { %>
            <option value="<%= code %>" <%= filters.status === code ? 'selected' : '' %>><%= code %> - <%= statusLabels[code] %></option>
          <% }); %>
        </select>
        <select name="isActive">
          <option value="">Ativos e inativos</option>
          <option value="true" <%= filters.isActive === 'true' ? 'selected' : '' %>>Somente ativos</option>
          <option value="false" <%= filters.isActive === 'false' ? 'selected' : '' %>>Somente inativos</option>
        </select>
        <button type="submit">Filtrar</button>
        <a href="/shipments" class="filter-clear">Limpar</a>
      </form>
      <table class="data-table">
        <thead>
          <tr><th>Referência</th><th>Exportador</th><th>Importador</th><th>Modal</th><th>Classificação</th><th>Status</th><th>Situação</th><th>Ações</th></tr>
        </thead>
        <tbody>
          <% if (shipments.length === 0) { %>
            <tr><td colspan="8">Nenhum embarque cadastrado ainda.</td></tr>
          <% } %>
          <% shipments.forEach(function(s) { %>
            <tr>
              <td><a href="/shipments/<%= s._id %>"><%= s.reference || s._id %></a></td>
              <td><%= s.exporterCompany ? s.exporterCompany.name : '—' %></td>
              <td><%= s.importerCompany ? s.importerCompany.name : '—' %></td>
              <td><%= s.modal %></td>
              <td><%= s.processType %></td>
              <td><%= s.status %> - <%= statusLabels[s.status] %></td>
              <td><span class="status-badge <%= s.isActive ? 'status-active' : 'status-inactive' %>"><%= s.isActive ? 'Ativo' : 'Cancelado' %></span></td>
              <td class="row-actions">
                <a href="/shipments/<%= s._id %>/edit">Editar</a>
                <% if (s.isActive) { %>
                  <form method="POST" action="/shipments/<%= s._id %>/delete" onsubmit="return confirm('Cancelar este embarque?');">
                    <button type="submit" class="link-button">Cancelar</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/shipments/<%= s._id %>/reactivate">
                    <button type="submit" class="link-button link-button-positive">Reabrir</button>
                  </form>
                <% } %>
                <form method="POST" action="/shipments/<%= s._id %>/hard-delete" onsubmit="return confirm('Excluir este embarque DEFINITIVAMENTE? Essa ação não pode ser desfeita e requer permissão de System Administrator.');">
                  <button type="submit" class="link-button">Excluir definitivamente</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
<%- include('partials/footer') %>
