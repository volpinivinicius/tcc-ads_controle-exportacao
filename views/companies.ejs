<%- include('partials/head', { title: 'Empresas' }) %>
<%- include('partials/sidebar', { activePage: 'companies' }) %>
      <h1>Empresas</h1>
      <table class="data-table">
        <thead>
          <tr><th>Nome</th><th>Tax ID</th><th>País</th><th>Papéis</th><th>Grupo</th></tr>
        </thead>
        <tbody>
          <% if (companies.length === 0) { %>
            <tr><td colspan="5">Nenhuma empresa cadastrada ainda.</td></tr>
          <% } %>
          <% companies.forEach(function(c) { %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.taxId %></td>
              <td><%= c.country %></td>
              <td><%= c.businessRoles.join(', ') %></td>
              <td><%= c.isGroupCompany ? 'Sim' : 'Não' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
<%- include('partials/footer') %>
